# Copy to .env to override the default local SQL Server password.
# Must meet SQL Server complexity rules (8+ chars, upper, lower, digit, symbol).
SA_PASSWORD=QuickCover_Dev123!

# Host ports for Redis, RabbitMQ and the web app. The defaults avoid clashing with other local
# stacks on 6379/5672/15672/3000. Containers still talk to each other on the standard ports.
REDIS_PORT=6380
RABBITMQ_PORT=5673
RABBITMQ_UI_PORT=15673
WEB_PORT=3080
